{
  "name": "apple-music-duplicate-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only, local duplicate detection for the current Apple Music playlist.",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "check": "npm run build && npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=22.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "fflate": "0.8.3",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
