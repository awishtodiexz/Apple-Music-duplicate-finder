{
  "name": "apple-music-duplicate-finder",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only, local duplicate detection for the current Apple Music playlist.",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:extension": "npm run build && node scripts/extension-smoke.mjs",
    "test:package": "npm run package && node scripts/package-test.mjs",
    "check:security": "node scripts/security-test.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run build && npm test && npm run test:browser && npm run test:extension && npm run test:package && npm run check:security"
  },
  "engines": {
    "node": "^22.8.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2"
  }
}
