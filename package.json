{
  "name": "apple-music-duplicate-finder",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Read-only, local duplicate detection for the current Apple Music playlist.",
  "license": "MIT",
  "author": "awishtodiexz",
  "homepage": "https://github.com/awishtodiexz/Apple-Music-duplicate-finder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awishtodiexz/Apple-Music-duplicate-finder.git"
  },
  "bugs": {
    "url": "https://github.com/awishtodiexz/Apple-Music-duplicate-finder/issues"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:extension": "npm run build && node scripts/extension-smoke.mjs",
    "test:package": "npm run package && node scripts/package-test.mjs",
    "check:security": "node scripts/security-test.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "benchmark": "node --expose-gc scripts/benchmark.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run check:docs && npm run build && npm test && npm run test:browser && npm run test:extension && npm run test:package && npm run check:security"
  },
  "engines": {
    "node": "^22.8.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3"
  }
}
